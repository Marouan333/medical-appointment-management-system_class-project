# ===== Shared =====
JWT_SECRET=change-me-in-prod-super-secret-key-256bits
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Postgres (single instance, multi-DB) =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===== Service URLs (used for inter-service calls) =====
AUTH_SERVICE_URL=http://auth-service:8000
PATIENT_SERVICE_URL=http://patient-service:8000
PRACTITIONER_SERVICE_URL=http://practitioner-service:8000
APPOINTMENT_SERVICE_URL=http://appointment-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
ANALYTICS_SERVICE_URL=http://analytics-service:8000

# ===== Mail (Mailhog dev) =====
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@medical-rdv.local
